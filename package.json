{
  "name": "gatepass",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node tools/launch-dummy-sso.mjs",
    "test:directory": "node --test tests/directory.test.ts",
    "directory:preview": "node tools/preview-directory.ts",
    "test:guard-auth": "node --test tests/guard-auth.test.ts",
    "test:registration": "node --test tests/registration.test.ts",
    "test:visit-reads": "node --test tests/visit-reads.test.ts",
    "test:printing": "node --test tests/pass-printing.test.ts",
    "printing:preview": "node tools/preview-print-cards.ts",
    "test:guard-movement": "node --test tests/guard-movement.test.ts",
    "test:transport": "node --test tests/http-api.test.ts tests/sql-procedure-client.test.ts tests/api-composition.test.ts tests/registration-http.test.ts",
    "test": "node --test --test-concurrency=4 tests/*.test.ts",
    "start:api": "node tools/start-api.ts",
    "dev:sso": "node tools/launch-dummy-sso.mjs",
    "test:dummy-sso": "node --test tests/dummy-sso.test.ts",
    "storage:init": "node tools/initialize-private-storage.ts",
    "test:storage": "node --test tests/private-storage.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:ci": "node tools/ci/run-tests.mjs",
    "test:browser": "playwright test",
    "check:migrations": "node tools/ci/migrations.mjs",
    "scan:secrets": "node tools/ci/scan-secrets.mjs",
    "release:prepare": "node tools/ci/release.mjs",
    "smoke:staging": "node tools/ci/staging-smoke.mjs",
    "start:email": "node tools/start-email-worker.ts",
    "mail:preview": "node tools/preview-email.ts",
    "mail:connect": "node tools/connect-personal-outlook.ts connect",
    "mail:status": "node tools/connect-personal-outlook.ts status",
    "mail:test": "node tools/connect-personal-outlook.ts test",
    "mail:disconnect": "node tools/connect-personal-outlook.ts disconnect",
    "mail:dev": "node tools/start-development-email.ts",
    "mail:scenario": "node tools/create-email-test.ts",
    "mail:outlook-preview": "node tools/preview-outlook-approval.ts"
  },
  "engines": {
    "node": ">=26.8.0 <27"
  },
  "dependencies": {
    "@azure/msal-node": "7.1.0",
    "@zxing/library": "0.23.0",
    "flag-icons": "7.6.0",
    "jose": "6.2.13",
    "libphonenumber-js": "1.13.15",
    "mssql": "12.7.10",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "eslint": "10.13.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
