# Copy to .env on the production VM. Never commit .env or share its contents.
# Existing service environment variables take precedence. Avoid duplicate settings.
# Quote passwords containing # or spaces. Use absolute paths with forward slashes.
NODE_ENV=production
GATEPASS_ORIGIN=
GATEPASS_BIND_ADDRESS=127.0.0.1
GATEPASS_SSO_MODE=corporate
GATEPASS_DIRECTORY_MODE=api

# SQL Server: private database and separate restricted service logins.
GATEPASS_DB_SERVER=
GATEPASS_DB_PORT=1433
GATEPASS_DB_NAME=GatePass
GATEPASS_API_DB_USER=
GATEPASS_API_DB_PASSWORD=
GATEPASS_AUTH_DB_USER=
GATEPASS_AUTH_DB_PASSWORD=
GATEPASS_WORKER_DB_USER=
GATEPASS_WORKER_DB_PASSWORD=

# HTTPS PEM file paths; private key material stays in protected files.
GATEPASS_TLS_KEY_FILE=
GATEPASS_TLS_CERT_FILE=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
GATEPASS_SOURCE_KEY=

# Single-process request admission. Public work cannot fill all protected slots.
# Tune per-source public budget for the office NAT/load profile; forwarding headers are not trusted.
GATEPASS_API_MAX_IN_FLIGHT=32
GATEPASS_PUBLIC_MAX_IN_FLIGHT=8
GATEPASS_PUBLIC_REQUESTS_PER_MINUTE=300

# Organization Graph mail: application permissions, no personal sender token cache.
GATEPASS_MAIL_AUTH_MODE=application
GATEPASS_MAIL_SENDER=
GATEPASS_GRAPH_TENANT_ID=
GATEPASS_GRAPH_CLIENT_ID=
GATEPASS_GRAPH_CLIENT_SECRET=
# Approved adapter modules / private photo root, outside the public application files.
GATEPASS_MAIL_DIRECTORY_MODULE=
GATEPASS_EMAIL_LINKS_MODULE=
GATEPASS_MAIL_PHOTOS_ROOT=

# Optional native Outlook action buttons. Leave disabled until separately approved.
GATEPASS_OUTLOOK_ACTIONS_ENABLED=false
GATEPASS_OUTLOOK_PROVIDER_ID=
GATEPASS_OUTLOOK_TENANT_ID=
GATEPASS_OUTLOOK_APPLICATION_ID=
GATEPASS_OUTLOOK_SCOPE=
GATEPASS_OUTLOOK_KEYS_MODULE=
GATEPASS_OUTLOOK_DB_USER=
GATEPASS_OUTLOOK_DB_PASSWORD=

# Reserved for pending corporate SSO, directory and Google integrations.
# These values do not enable integrations until their production adapters are implemented.
# GATEPASS_ENTRA_TENANT_ID=
# GATEPASS_ENTRA_CLIENT_ID=
# GATEPASS_ENTRA_CLIENT_SECRET=
# GATEPASS_ENTRA_REDIRECT_URI=
# GATEPASS_DIRECTORY_API_URL=
# GATEPASS_DIRECTORY_API_TOKEN=
# GATEPASS_GOOGLE_CLIENT_ID=
# GATEPASS_GOOGLE_CLIENT_SECRET=
# GATEPASS_GOOGLE_REDIRECT_URI=

# Local runner only; not used by production services.
# GATEPASS_DUMMY_PORT=8443
# GATEPASS_DEV_RPC_WORKERS=4
